{
  "name": "@microblink/blinkcard-react-native",
  "version": "3001.0.0",
  "description": "React Native module for BlinkCard, SDK for scanning and OCR of credit or payment cards.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "prepare": "bob build",
    "typecheck": "tsc"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "credit-card",
    "scanning",
    "card",
    "scanner",
    "sdk",
    "reactnative",
    "machine-learning",
    "add-card",
    "new-payment-method"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microblink/blinkcard-react-native"
  },
  "author": {
    "name": "Microblink (https://microblink.com)",
    "email": "support@microblink.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/microblink/blinkcard-react-native/issues"
  },
  "homepage": "https://github.com/microblink/blinkcard-react-native#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
  "@react-native-community/cli": "17.0.1",
  "react-native": "^0.82.1",
  "del-cli": "^5.1.0",
  "react-native-builder-bob": "^0.40.10",
  "typescript": "^5.2.2"
},
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "BlinkCardReactNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.microblink.blinkcard.reactnative"
    }
  }
}
